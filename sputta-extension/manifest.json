{
  "manifest_version": 3,
  "name": "sPutta Explain",
  "version": "1.0.0",
  "description": "Highlight text on any page and get a simple explanation from sPutta.",
  "host_permissions": ["https://sputa.onrender.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}